+/// `convert … out.png`: one printed page as a PNG (`file.exportPng`).
+fn convert_png(a: &Args, input: &str, out: &str) -> Result<(), String> {
+    let mut s = open(input)?;
+    activate_sheet(&mut s, a.opt("sheet"))?;
+    let mut p = json!({"path": out});
+    if let Some(r) = a.opt("range") {
+        p["range"] = json!(r);
+    }
+    for key in ["page", "scale"] {
+        if let Some(v) = a.opt(key) {
+            p[key] = json!(v.parse::<f64>().map_err(|_| format!("--{key}: not a number: {v}"))?);
+        }
+    }
+    if a.has("fit") {
+        p["fitToPage"] = json!(true);
+    }
+    let r = exec(&mut s, "file.exportPng", p)?;
+    eprintln!("wrote {out} ({}x{} px, {} bytes, page {} of {})", r["width"], r["height"], r["bytes"], r["page"], r["pages"]);
+    Ok(())
+}
