+pub(crate) fn export_png(s: &mut Session, p: &Json) -> Result<Json> {
+    const CMD: &str = "file.exportPng";
+    let opts = PrintOptions::from_params(p, CMD)?;
+    let scale = match f64_param(p, "scale") {
+        None => 1.0,
+        Some(v) if v.is_finite() && v > 0.0 && v <= 16.0 => v as f32,
+        Some(v) => return Err(bad(CMD, format!("`scale` must be a number in (0, 16], not {v}"))),
+    };
+    let page = match f64_param(p, "page") {
+        None => 1,
+        Some(v) if v.is_finite() && (1.0..1.0e9).contains(&v) => v as usize,
+        Some(v) => return Err(bad(CMD, format!("`page` must be a page number from 1, not {v}"))),
+    };
+    let d = s.doc()?;
+    let lays = layouts(&d.wb, &opts);
+    let pages: usize = lays.iter().map(|l| l.pages.len()).sum();
+    let path = d.path.clone().unwrap_or_default();
+    let Some(rec) = assemble_pages(&d.wb, &lays, &d.display_title(), &path).into_iter().nth(page - 1) else {
+        return Err(bad(CMD, format!("page {page} does not exist (the print has {pages})")));
+    };
+    let png = render_png(&rec, scale).map_err(|e| bad(CMD, e.to_string()))?;
+    let mut out = json!({"pages": pages, "page": page, "width": png.width, "height": png.height, "bytes": png.bytes.len()});
+    match str_param(p, "path").filter(|x| !x.is_empty()) {
+        Some(path) => {
+            crate::io::write_file(path, &png.bytes)?;
+            out["path"] = json!(path);
+        }
+        None => out["base64"] = json!(crate::io::base64_encode(&png.bytes)),
+    }
+    Ok(out)
+}
