index 0000000..d3ae088
--- /dev/null
+++ b/crates/raster/src/lib.rs
@@ -0,0 +1,314 @@
+//! GridCraft's PNG backend: rasterises a print display list ([`gridcraft_pdf::Rec`]) on the CPU.
+//!
+//! Pure Rust, no GPU and no system fonts: `vello_cpu` fills and strokes the paths, `skrifa` turns
+//! glyphs into outlines. The 12 standard PDF fonts are drawn with metric-compatible faces embedded
+//! in the binary (Arimo for Helvetica, Tinos for Times, Cousine for Courier; SIL OFL 1.1, see
+//! `fonts/`), subset to WinAnsi plus a few symbols. Each glyph is placed on the same AFM advance
+//! (`Font::char_width`) the layout measured with, so what is drawn lines up with what was
+//! measured, exactly as in the PDF.
+//!
+//! Coordinates are the display list's: points, top-left origin. One point is `scale` pixels.
+#![deny(clippy::unwrap_used, clippy::expect_used, clippy::panic, clippy::unimplemented, clippy::todo, clippy::unreachable)]
+#![forbid(unsafe_code)]
+
+mod text;
+
+use gridcraft_pdf::{Font, Op, Rec, Rgb};
+use std::sync::Arc;
+use vello_cpu::color::{AlphaColor, PremulRgba8, Srgb};
+use vello_cpu::kurbo::{Affine, BezPath, Cap, Circle, Join, Rect, Shape, Stroke};
+use vello_cpu::peniko::{Fill, ImageSampler};
+use vello_cpu::{Image, ImageSource, Pixmap, RenderContext, Resources};
+
+/// Largest image a page may rasterise to, in pixels.
+pub const MAX_PIXELS: u64 = 64_000_000;
+/// Largest source image accepted for drawing (pixels), as in the PDF writer.
+const MAX_IMAGE_PIXELS: u64 = 40_000_000;
+/// Curve flattening tolerance, in pixels.
+const TOL: f64 = 0.05;
+
+/// Why a page could not be rasterised.
+#[derive(Debug, Clone, PartialEq, Eq)]
+pub enum RasterError {
+    /// The page size or scale is not a positive finite number.
+    BadSize,
+    /// The result would exceed [`MAX_PIXELS`] (or 65535 pixels on a side).
+    TooLarge { width: u64, height: u64 },
+    /// PNG encoding failed.
+    Encode(String),
+}
+
+impl std::fmt::Display for RasterError {
+    fn fmt(&self, f: &mut std::fmt::Formatter<'_>) -> std::fmt::Result {
+        match self {
+            RasterError::BadSize => write!(f, "page size or scale is not a positive finite number"),
+            RasterError::TooLarge { width, height } => write!(f, "{width}x{height} pixels is too large (limit {MAX_PIXELS}); lower `scale`"),
+            RasterError::Encode(e) => write!(f, "PNG encoding failed: {e}"),
+        }
+    }
+}
+
+impl std::error::Error for RasterError {}
+
+/// A finished PNG.
+#[derive(Debug, Clone)]
+pub struct Png {
+    pub bytes: Vec<u8>,
+    pub width: u32,
+    pub height: u32,
+}
+
+/// Rasterises one recorded page to a PNG on an opaque white background; `scale` is pixels per
+/// point.
+pub fn render_png(page: &Rec, scale: f32) -> Result<Png, RasterError> {
+    let pm = render_pixmap(page, scale)?;
+    let (width, height) = (u32::from(pm.width()), u32::from(pm.height()));
+    let bytes = pm.into_png().map_err(|e| RasterError::Encode(e.to_string()))?;
+    Ok(Png { bytes, width, height })
+}
+
+/// Rasterises one recorded page to premultiplied RGBA pixels.
+pub fn render_pixmap(page: &Rec, scale: f32) -> Result<Pixmap, RasterError> {
+    let mut r = Raster::new(page.width, page.height, scale)?;
+    for op in &page.ops {
+        r.apply(op);
+    }
+    Ok(r.finish())
+}
+
+/// Paints ops into a render context.
+struct Raster {
+    ctx: RenderContext,
+    s: f64,
+    w: u16,
+    h: u16,
+    /// Clip paths pushed since each `save` (the first entry is the page level).
+    clips: Vec<u32>,
+    glyphs: text::GlyphCache,
+}
+
+fn finite(v: &[f32]) -> bool {
+    v.iter().all(|x| x.is_finite())
+}
+
+fn extent(v: f32) -> bool {
+    v > 0.0 && v.is_finite()
+}
+
+fn stroke_width(w: f32) -> f32 {
+    if w.is_finite() { w.max(0.0) } else { 0.0 }
+}
+
+fn color(c: Rgb) -> AlphaColor<Srgb> {
+    AlphaColor::from_rgba8(c[0], c[1], c[2], 255)
+}
+
+/// A dash pattern as the PDF writer reads it: at most 8 entries, all finite, at least one
+/// positive; anything else is solid. An odd count repeats (PDF semantics).
+fn dashes(dash: &[f32]) -> Vec<f64> {
+    let d: Vec<f32> = dash.iter().take(8).map(|v| v.max(0.0)).collect();
+    if d.is_empty() || !finite(&d) || !d.iter().any(|v| (v.min(1.0e7) * 1000.0).round() > 0.0) {
+        return Vec::new();
+    }
+    d.iter().chain(if d.len() % 2 == 1 { d.iter() } else { [].iter() }).map(|v| f64::from(*v)).collect()
+}
+
+impl Raster {
+    /// A white canvas for a page of `w`×`h` points at `scale` pixels per point.
+    fn new(w: f32, h: f32, scale: f32) -> Result<Raster, RasterError> {
+        if !(extent(w) && extent(h) && extent(scale)) {
+            return Err(RasterError::BadSize);
+        }
+        let (pw, ph) = (((w * scale).ceil() as u64).max(1), ((h * scale).ceil() as u64).max(1));
+        if pw.saturating_mul(ph) > MAX_PIXELS || pw > u64::from(u16::MAX) || ph > u64::from(u16::MAX) {
+            return Err(RasterError::TooLarge { width: pw, height: ph });
+        }
+        let (w16, h16) = (pw as u16, ph as u16);
+        let mut ctx = RenderContext::new(w16, h16);
+        ctx.set_paint(color([255, 255, 255]));
+        ctx.fill_rect(&Rect::new(0.0, 0.0, f64::from(w16), f64::from(h16)));
+        Ok(Raster { ctx, s: f64::from(scale), w: w16, h: h16, clips: vec![0], glyphs: text::GlyphCache::default() })
+    }
+
+    fn finish(mut self) -> Pixmap {
+        while let Some(n) = self.clips.pop() {
+            for _ in 0..n {
+                self.ctx.pop_clip_path();
+            }
+        }
+        self.ctx.flush();
+        let mut pm = Pixmap::new(self.w, self.h);
+        self.ctx.render(&mut pm, &mut Resources::new());
+        pm
+    }
+
+    /// A page-space point in pixels.
+    fn px(&self, x: f32, y: f32) -> (f64, f64) {
+        (f64::from(x) * self.s, f64::from(y) * self.s)
+    }
+
+    fn fill(&mut self, path: &BezPath, c: Rgb) {
+        self.ctx.set_paint(color(c));
+        self.ctx.set_fill_rule(Fill::NonZero);
+        self.ctx.fill_path(path);
+    }
+
+    fn stroke(&mut self, path: &BezPath, width: f32, dash: &[f32], join: Join, c: Rgb) {
+        let mut st = Stroke::new(f64::from(stroke_width(width)) * self.s).with_join(join).with_caps(Cap::Butt);
+        let d = dashes(dash);
+        if !d.is_empty() {
+            st = st.with_dashes(0.0, d.iter().map(|v| v * self.s));
+        }
+        self.ctx.set_stroke(st);
+        self.ctx.set_paint(color(c));
+        self.ctx.stroke_path(path);
+    }
+
+    fn poly_path(&self, pts: &[[f32; 2]], close: bool) -> BezPath {
+        let mut p = BezPath::new();
+        for (i, q) in pts.iter().enumerate() {
+            let (x, y) = self.px(q[0], q[1]);
+            if i == 0 {
+                p.move_to((x, y));
+            } else {
+                p.line_to((x, y));
+            }
+        }
+        if close {
+            p.close_path();
+        }
+        p
+    }
+
+    fn fill_and_stroke(&mut self, path: &BezPath, fill: Option<Rgb>, stroke: Option<(Rgb, f32)>, join: Join) {
+        if let Some(f) = fill {
+            self.fill(path, f);
+        }
+        if let Some((c, w)) = stroke {
+            self.stroke(path, w, &[], join, c);
+        }
+    }
+
+    /// Performs one display-list op.
+    fn apply(&mut self, op: &Op) {
+        match op {
+            Op::Save => self.clips.push(0),
+            Op::Restore => {
+                if self.clips.len() > 1
+                    && let Some(n) = self.clips.pop()
+                {
+                    for _ in 0..n {
+                        self.ctx.pop_clip_path();
+                    }
+                }
+            }
+            Op::ClipRect(x, y, w, h) => {
+                if finite(&[*x, *y, *w, *h]) {
+                    let (x0, y0) = self.px(*x, *y);
+                    let (x1, y1) = self.px(x + w.max(0.0), y + h.max(0.0));
+                    self.ctx.push_clip_path(&Rect::new(x0, y0, x1, y1).to_path(TOL));
+                    if let Some(n) = self.clips.last_mut() {
+                        *n += 1;
+                    }
+                }
+            }
+            Op::FillRect(x, y, w, h, c) => {
+                if extent(*w) && extent(*h) && finite(&[*x, *y]) {
+                    let (x0, y0) = self.px(*x, *y);
+                    let (x1, y1) = self.px(x + w, y + h);
+                    self.fill(&Rect::new(x0, y0, x1, y1).to_path(TOL), *c);
+                }
+            }
+            Op::RectStroke(x, y, w, h, lw, c) => {
+                if finite(&[*x, *y, *w, *h]) {
+                    let p = self.poly_path(&[[*x, *y], [x + w, *y], [x + w, y + h], [*x, y + h]], true);
+                    self.stroke(&p, *lw, &[], Join::Miter, *c);
+                }
+            }
+            Op::StrokeLine(x0, y0, x1, y1, lw, c) => self.line(*x0, *y0, *x1, *y1, *lw, *c, &[]),
+            Op::StrokeLineDashed(x0, y0, x1, y1, lw, c, d) => self.line(*x0, *y0, *x1, *y1, *lw, *c, d),
+            Op::Polyline(pts, lw, c, d) => {
+                if pts.len() >= 2 && pts.iter().all(|p| finite(p)) {
+                    let p = self.poly_path(pts, false);
+                    self.stroke(&p, *lw, d, Join::Round, *c);
+                }
+            }
+            Op::Polygon(pts, f, st) => {
+                if pts.len() >= 2 && (f.is_some() || st.is_some()) && pts.iter().all(|p| finite(p)) {
+                    let p = self.poly_path(pts, true);
+                    self.fill_and_stroke(&p, *f, *st, Join::Round);
+                }
+            }
+            Op::Circle(cx, cy, r, f, st) => {
+                if extent(*r) && finite(&[*cx, *cy]) && (f.is_some() || st.is_some()) {
+                    let (px, py) = self.px(*cx, *cy);
+                    let p = Circle::new((px, py), f64::from(*r) * self.s).to_path(TOL);
+                    self.fill_and_stroke(&p, *f, *st, Join::Miter);
+                }
+            }
+            Op::Text(x, y, sz, f, c, t) => self.text(*x, *y, *sz, *f, *c, t, 0.0),
+            Op::TextRotated(x, y, sz, f, c, t, a) => self.text(*x, *y, *sz, *f, *c, t, *a),
+            Op::ImageRgba(x, y, w, h, px, pw, ph) => self.image(*x, *y, *w, *h, px, *pw, *ph),
+        }
+    }
+
+    #[allow(clippy::too_many_arguments)]
+    fn line(&mut self, x0: f32, y0: f32, x1: f32, y1: f32, width: f32, c: Rgb, dash: &[f32]) {
+        if finite(&[x0, y0, x1, y1]) {
+            let p = self.poly_path(&[[x0, y0], [x1, y1]], false);
+            self.stroke(&p, width, dash, Join::Miter, c);
+        }
+    }
+
+    #[allow(clippy::too_many_arguments)]
+    fn text(&mut self, x: f32, y: f32, size: f32, font: Font, c: Rgb, text: &str, angle: f32) {
+        if text.is_empty() || !extent(size) || !finite(&[x, y]) {
+            return;
+        }
+        let (sn, cs) = if angle.is_finite() { angle.sin_cos() } else { (0.0, 1.0) };
+        let size = size.min(10_000.0);
+        self.ctx.set_paint(color(c));
+        self.ctx.set_fill_rule(Fill::NonZero);
+        let sc = self.s;
+        let mut adv = 0.0f32;
+        for ch in text.chars() {
+            if let Some(path) = self.glyphs.path(font, ch) {
+                // Em-unit glyph (y up) -> pixels: scale by size, flip y, rotate clockwise about
+                // the baseline origin, move to the pen position.
+                let (a, b) = (self.s * f64::from(size * cs), self.s * f64::from(size * sn));
+                let (tx, ty) = (f64::from(x + cs * adv) * sc, f64::from(y + sn * adv) * sc);
+                self.ctx.set_transform(Affine::new([a, b, b, -a, tx, ty]));
+                self.ctx.fill_path(path);
+            }
+            adv += f32::from(font.char_width(ch)) * size / 1000.0;
+        }
+        self.ctx.reset_transform();
+    }
+
+    #[allow(clippy::too_many_arguments)]
+    fn image(&mut self, x: f32, y: f32, w: f32, h: f32, rgba: &[u8], pw: u32, ph: u32) {
+        let px = u64::from(pw) * u64::from(ph);
+        if pw == 0 || ph == 0 || px > MAX_IMAGE_PIXELS || (rgba.len() as u64) < px * 4 || !(extent(w) && extent(h) && finite(&[x, y])) {
+            return;
+        }
+        let (Ok(pw16), Ok(ph16)) = (u16::try_from(pw), u16::try_from(ph)) else { return };
+        let data: Vec<PremulRgba8> = rgba
+            .as_chunks::<4>()
+            .0
+            .iter()
+            .take(px as usize)
+            .map(|p| {
+                let a = u32::from(p[3]);
+                let m = |c: u8| ((u32::from(c) * a + 127) / 255) as u8;
+                PremulRgba8 { r: m(p[0]), g: m(p[1]), b: m(p[2]), a: p[3] }
+            })
+            .collect();
+        let img = Image { image: ImageSource::Pixmap(Arc::new(Pixmap::from_parts(data, pw16, ph16))), sampler: ImageSampler::default() };
+        let (x0, y0) = self.px(x, y);
+        let (x1, y1) = self.px(x + w, y + h);
+        self.ctx.set_paint(img);
+        self.ctx.set_paint_transform(Affine::new([(x1 - x0) / f64::from(pw), 0.0, 0.0, (y1 - y0) / f64::from(ph), x0, y0]));
+        self.ctx.fill_rect(&Rect::new(x0, y0, x1, y1));
+        self.ctx.reset_paint_transform();
+    }
+}
