+[package]
+name = "gridcraft-raster"
+version.workspace = true
+edition.workspace = true
+license.workspace = true
+description = "GridCraft's pure-Rust, CPU-only PNG rasteriser for print display lists (gridcraft-pdf ops)"
+
+[lints]
+workspace = true
+
+[dependencies]
+gridcraft-pdf = { workspace = true }
+# The same rasteriser and font parser the sibling crafts (WordCraft, DeckCraft) use. The `text`
+# feature (glyph runs) is off: glyphs are drawn as outlines.
+vello_cpu = { version = "0.2", default-features = false, features = ["std", "png", "u8_pipeline"] }
+# Not the workspace `skrifa` (0.44, pinned to egui's for the UI): the version the siblings use.
+skrifa = { version = "0.47", default-features = false, features = ["std"] }
