diff --git a/crates/pdf/src/display.rs b/crates/pdf/src/display.rs
new file mode 100644
index 0000000..65b30e2
--- /dev/null
+++ b/crates/pdf/src/display.rs
@@ -0,0 +1,106 @@
+//! A backend-neutral display list of one page: the [`Op`] enum (the 13 drawing calls print layout
+//! uses), the [`Rec`] recorder that collects them with the same method names as [`Page`], and
+//! [`replay`], which writes them to a PDF page. Other backends (the PNG rasteriser) walk
+//! [`Rec::ops`] themselves.
+//!
+//! Semantics every backend shares (those `Page` has always had): coordinates in points, top-left
+//! origin; `save`/`restore` nest and clipping lasts to the enclosing `restore`; non-finite
+//! coordinates drop the op; a non-positive extent or radius draws nothing; negative or NaN stroke
+//! widths become 0; an invalid or all-zero dash means solid.
+
+use crate::{Font, Page, Rgb};
+
+/// One drawing call, recorded: the 13 operations print layout uses on a page. Everything an op
+/// carries is final (points, top-left origin, text already measured and positioned, colours and
+/// fonts resolved), so a list is independent of the backend that replays it.
+#[derive(Clone, Debug, PartialEq)]
+pub enum Op {
+    Save,
+    Restore,
+    ClipRect(f32, f32, f32, f32),
+    FillRect(f32, f32, f32, f32, Rgb),
+    RectStroke(f32, f32, f32, f32, f32, Rgb),
+    StrokeLine(f32, f32, f32, f32, f32, Rgb),
+    StrokeLineDashed(f32, f32, f32, f32, f32, Rgb, Vec<f32>),
+    Polyline(Vec<[f32; 2]>, f32, Rgb, Vec<f32>),
+    Polygon(Vec<[f32; 2]>, Option<Rgb>, Option<(Rgb, f32)>),
+    Circle(f32, f32, f32, Option<Rgb>, Option<(Rgb, f32)>),
+    Text(f32, f32, f32, Font, Rgb, String),
+    TextRotated(f32, f32, f32, Font, Rgb, String, f32),
+    ImageRgba(f32, f32, f32, f32, Vec<u8>, u32, u32),
+}
+
+/// A page of display list. Its methods mirror `gridcraft_pdf::Page`'s, so the drawing code reads
+/// the same; nothing is drawn until [`replay`] feeds the ops to a real page.
+pub struct Rec {
+    pub width: f32,
+    pub height: f32,
+    pub ops: Vec<Op>,
+}
+
+#[allow(clippy::too_many_arguments)]
+impl Rec {
+    pub fn new(width: f32, height: f32) -> Rec {
+        Rec { width, height, ops: Vec::new() }
+    }
+    pub fn save(&mut self) {
+        self.ops.push(Op::Save);
+    }
+    pub fn restore(&mut self) {
+        self.ops.push(Op::Restore);
+    }
+    pub fn clip_rect(&mut self, x: f32, y: f32, w: f32, h: f32) {
+        self.ops.push(Op::ClipRect(x, y, w, h));
+    }
+    pub fn fill_rect(&mut self, x: f32, y: f32, w: f32, h: f32, color: Rgb) {
+        self.ops.push(Op::FillRect(x, y, w, h, color));
+    }
+    pub fn rect_stroke(&mut self, x: f32, y: f32, w: f32, h: f32, width: f32, color: Rgb) {
+        self.ops.push(Op::RectStroke(x, y, w, h, width, color));
+    }
+    pub fn stroke_line(&mut self, x0: f32, y0: f32, x1: f32, y1: f32, width: f32, color: Rgb) {
+        self.ops.push(Op::StrokeLine(x0, y0, x1, y1, width, color));
+    }
+    pub fn stroke_line_dashed(&mut self, x0: f32, y0: f32, x1: f32, y1: f32, width: f32, color: Rgb, dash: &[f32]) {
+        self.ops.push(Op::StrokeLineDashed(x0, y0, x1, y1, width, color, dash.to_vec()));
+    }
+    pub fn polyline(&mut self, pts: &[[f32; 2]], width: f32, color: Rgb, dash: &[f32]) {
+        self.ops.push(Op::Polyline(pts.to_vec(), width, color, dash.to_vec()));
+    }
+    pub fn polygon(&mut self, pts: &[[f32; 2]], fill: Option<Rgb>, stroke: Option<(Rgb, f32)>) {
+        self.ops.push(Op::Polygon(pts.to_vec(), fill, stroke));
+    }
+    pub fn circle(&mut self, cx: f32, cy: f32, r: f32, fill: Option<Rgb>, stroke: Option<(Rgb, f32)>) {
+        self.ops.push(Op::Circle(cx, cy, r, fill, stroke));
+    }
+    pub fn text(&mut self, x: f32, y: f32, size: f32, font: Font, color: Rgb, text: &str) {
+        self.ops.push(Op::Text(x, y, size, font, color, text.to_string()));
+    }
+    pub fn text_rotated(&mut self, x: f32, y: f32, size: f32, font: Font, color: Rgb, text: &str, angle: f32) {
+        self.ops.push(Op::TextRotated(x, y, size, font, color, text.to_string(), angle));
+    }
+    pub fn image_rgba(&mut self, x: f32, y: f32, w: f32, h: f32, rgba: &[u8], pw: u32, ph: u32) {
+        self.ops.push(Op::ImageRgba(x, y, w, h, rgba.to_vec(), pw, ph));
+    }
+}
+
+/// Writes recorded ops to a PDF page, call for call.
+pub fn replay(pg: &mut Page, ops: &[Op]) {
+    for op in ops {
+        match op {
+            Op::Save => pg.save(),
+            Op::Restore => pg.restore(),
+            Op::ClipRect(x, y, w, h) => pg.clip_rect(*x, *y, *w, *h),
+            Op::FillRect(x, y, w, h, c) => pg.fill_rect(*x, *y, *w, *h, *c),
+            Op::RectStroke(x, y, w, h, lw, c) => pg.rect_stroke(*x, *y, *w, *h, *lw, *c),
+            Op::StrokeLine(x0, y0, x1, y1, lw, c) => pg.stroke_line(*x0, *y0, *x1, *y1, *lw, *c),
+            Op::StrokeLineDashed(x0, y0, x1, y1, lw, c, d) => pg.stroke_line_dashed(*x0, *y0, *x1, *y1, *lw, *c, d),
+            Op::Polyline(pts, lw, c, d) => pg.polyline(pts, *lw, *c, d),
+            Op::Polygon(pts, f, st) => pg.polygon(pts, *f, *st),
+            Op::Circle(cx, cy, r, f, st) => pg.circle(*cx, *cy, *r, *f, *st),
+            Op::Text(x, y, sz, f, c, t) => pg.text(*x, *y, *sz, *f, *c, t),
+            Op::TextRotated(x, y, sz, f, c, t, a) => pg.text_rotated(*x, *y, *sz, *f, *c, t, *a),
+            Op::ImageRgba(x, y, w, h, px, pw, ph) => pg.image_rgba(*x, *y, *w, *h, px, *pw, *ph),
+        }
+    }
+}
