index 0000000..14b7390
--- /dev/null
+++ b/crates/raster/src/text.rs
@@ -0,0 +1,88 @@
+//! Glyph outlines for the 12 standard fonts, from the embedded faces.
+
+use gridcraft_pdf::Font;
+use skrifa::instance::{LocationRef, Size};
+use skrifa::outline::{DrawSettings, OutlinePen};
+use skrifa::{FontRef, MetadataProvider};
+use std::collections::HashMap;
+use vello_cpu::kurbo::BezPath;
+
+macro_rules! face {
+    ($f:literal) => {
+        include_bytes!(concat!("../fonts/", $f, ".ttf")) as &[u8]
+    };
+}
+
+/// The embedded face for a standard font.
+fn data(font: Font) -> &'static [u8] {
+    match font {
+        Font::Helvetica => face!("Arimo_400Regular"),
+        Font::HelveticaBold => face!("Arimo_700Bold"),
+        Font::HelveticaOblique => face!("Arimo_400Regular_Italic"),
+        Font::HelveticaBoldOblique => face!("Arimo_700Bold_Italic"),
+        Font::TimesRoman => face!("Tinos_400Regular"),
+        Font::TimesBold => face!("Tinos_700Bold"),
+        Font::TimesItalic => face!("Tinos_400Regular_Italic"),
+        Font::TimesBoldItalic => face!("Tinos_700Bold_Italic"),
+        Font::Courier => face!("Cousine_400Regular"),
+        Font::CourierBold => face!("Cousine_700Bold"),
+        Font::CourierOblique => face!("Cousine_400Regular_Italic"),
+        Font::CourierBoldOblique => face!("Cousine_700Bold_Italic"),
+    }
+}
+
+struct Pen {
+    pb: BezPath,
+    k: f32,
+}
+
+impl OutlinePen for Pen {
+    fn move_to(&mut self, x: f32, y: f32) {
+        self.pb.move_to((f64::from(x * self.k), f64::from(y * self.k)));
+    }
+    fn line_to(&mut self, x: f32, y: f32) {
+        self.pb.line_to((f64::from(x * self.k), f64::from(y * self.k)));
+    }
+    fn quad_to(&mut self, cx0: f32, cy0: f32, x: f32, y: f32) {
+        let k = self.k;
+        self.pb.quad_to((f64::from(cx0 * k), f64::from(cy0 * k)), (f64::from(x * k), f64::from(y * k)));
+    }
+    fn curve_to(&mut self, cx0: f32, cy0: f32, cx1: f32, cy1: f32, x: f32, y: f32) {
+        let k = self.k;
+        self.pb.curve_to((f64::from(cx0 * k), f64::from(cy0 * k)), (f64::from(cx1 * k), f64::from(cy1 * k)), (f64::from(x * k), f64::from(y * k)));
+    }
+    fn close(&mut self) {
+        self.pb.close_path();
+    }
+}
+
+/// Glyph paths in em units (y up), cached per (font, char).
+#[derive(Default)]
+pub struct GlyphCache {
+    map: HashMap<(Font, char), Option<BezPath>>,
+}
+
+impl GlyphCache {
+    /// The outline of `c` in `font`. A character the PDF writer cannot encode (it writes `?`)
+    /// is drawn as `?`; a space or a glyph without outline gives `None`.
+    pub fn path(&mut self, font: Font, c: char) -> Option<&BezPath> {
+        self.map.entry((font, c)).or_insert_with(|| outline(font, c)).as_ref()
+    }
+}
+
+fn outline(font: Font, c: char) -> Option<BezPath> {
+    let face = FontRef::new(data(font)).ok()?;
+    let cm = face.charmap();
+    let gid = match cm.map(c) {
+        Some(g) => g,
+        None => cm.map('?')?,
+    };
+    let upem = face.metrics(Size::unscaled(), LocationRef::default()).units_per_em;
+    if upem == 0 {
+        return None;
+    }
+    let g = face.outline_glyphs().get(gid)?;
+    let mut pen = Pen { pb: BezPath::new(), k: 1.0 / f32::from(upem) };
+    g.draw(DrawSettings::unhinted(Size::unscaled(), LocationRef::default()), &mut pen).ok()?;
+    if pen.pb.elements().is_empty() { None } else { Some(pen.pb) }
+}
