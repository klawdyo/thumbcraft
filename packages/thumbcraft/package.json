{
  "name": "thumbcraft",
  "version": "0.1.0",
  "description": "Document thumbnail generator for Node.js: render DOCX, XLSX and PPTX (and ODT, ODS, RTF, CSV) to PNG, JPEG or WebP previews with a fast native binary, no LibreOffice",
  "keywords": [
    "thumbnail",
    "thumbnail-generator",
    "document-preview",
    "preview",
    "docx",
    "xlsx",
    "pptx",
    "word",
    "excel",
    "powerpoint",
    "office",
    "docx-to-png",
    "xlsx-to-png",
    "pptx-to-png",
    "odt",
    "ods",
    "rtf",
    "csv",
    "image",
    "png",
    "jpeg",
    "webp",
    "file-upload",
    "typescript",
    "rust",
    "native",
    "no-libreoffice"
  ],
  "homepage": "https://github.com/klawdyo/thumbcraft/tree/main/packages/thumbcraft#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/klawdyo/thumbcraft.git",
    "directory": "packages/thumbcraft"
  },
  "bugs": {
    "url": "https://github.com/klawdyo/thumbcraft/issues"
  },
  "license": "Apache-2.0",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "test": "node --test \"src/**/*.spec.ts\" \"tools/**/*.spec.ts\"",
    "build:packages": "node tools/build-packages-cli.ts"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "typescript": "^5.9.0"
  }
}
